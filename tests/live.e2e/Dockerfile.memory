FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

COPY requirements.txt /tmp/requirements.txt

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        jq \
        libgomp1 \
        libsqlcipher-dev \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        tini \
    && python3 -m venv /opt/memory-venv \
    && /opt/memory-venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/memory-venv/bin/pip install -r /tmp/requirements.txt \
    && /opt/memory-venv/bin/pip install pysqlcipher3 \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip /tmp/requirements.txt

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
